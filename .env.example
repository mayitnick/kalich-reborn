# .env example
# Copy this file to .env and fill in your credentials
BOT_TOKEN=your_bot_token_here
MODERATOR_ID=your_moderator_id_here
LOG_GROUP_ID=your_log_group_id_here

# Список специальных топиков (формат: CHAT_ID:THREAD_ID,CHAT_ID:THREAD_ID)
# SPECIAL_CHATS=-1002949492641:27602,-1003018365933:360

# ID учителей для автоматического одобрения (через запятую)
# TEACHER_IDS=123456789,987654321

# Telegram Mini App URL (HTTPS обязателен для Telegram WebApp)
WEBAPP_URL=https://fin.waifuvpn.ru
