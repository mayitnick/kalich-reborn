# syntax=docker/dockerfile:1
# -------- Builder stage --------
FROM node:20-alpine AS builder
WORKDIR /app
COPY pwa/package*.json ./
RUN npm ci
COPY pwa/ ./
# If there is a build script (e.g., for bundling), run it; otherwise just copy files.
RUN if [ -f package.json ] && grep -q "build" package.json; then npm run build; else echo "No build step"; fi

# -------- Runtime stage --------
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# If the build output is directly in /app (no dist), copy everything.
#COPY --from=builder /app /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;" ]
